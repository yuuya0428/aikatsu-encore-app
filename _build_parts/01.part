<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#e83b91"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="apple-mobile-web-app-title" content="アイカツ！アンコール"><link rel="apple-touch-icon" href="icons/apple-touch-icon.png"><link rel="manifest" href="manifest.webmanifest"><title>アイカツ！アンコール カード帳</title>
<style>
:root{color-scheme:light dark;--bg:#fff6fb;--surface:light-dark(#fff,#241b24);--surface2:light-dark(#fff9fc,#302330);--text:light-dark(#4b3346,#f7eaf4);--muted:light-dark(#987a91,#cdb4c8);--line:light-dark(#f0d7e8,#503c4d);--pink:light-dark(#e83b91,#ff68ad);--pink2:light-dark(#f7d8e9,#593047);--mint:light-dark(#54a99b,#77d0c0);}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Noto Sans JP",sans-serif;color:var(--text)}#app{min-height:100vh;background:linear-gradient(180deg,light-dark(#fff7fb,#211820),var(--bg))}
header{padding:22px 18px 14px;position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--surface) 90%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px}.logo{width:48px;height:48px;border-radius:15px;background:var(--pink);color:white;display:grid;place-items:center;font-weight:900;font-size:22px;box-shadow:0 8px 24px #e83b9130}h1{font-size:21px;margin:0}.sub{font-size:12px;color:var(--muted);margin-top:3px}.stats{margin-top:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:var(--surface);border:1px solid var(--line);border-radius:15px;padding:10px;text-align:center}.stat b{font-size:19px}.stat small{display:block;color:var(--muted);font-size:10px;margin-top:2px}
main{padding:14px 14px 90px;max-width:1050px;margin:auto}.tabs{display:flex;gap:8px;margin:2px 0 14px;overflow:auto}button,select,input{font:inherit}button{border:0;cursor:pointer}.tab{padding:10px 16px;border-radius:999px;background:var(--surface);border:1px solid var(--line);color:var(--muted);white-space:nowrap;font-weight:700}.tab.active{background:var(--pink);color:#fff;border-color:var(--pink)}.toolbar{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:12px;margin-bottom:14px}.search{width:100%;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:var(--surface2);color:var(--text);outline:none}.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:9px}select{width:100%;padding:10px;border-radius:12px;border:1px solid var(--line);background:var(--surface2);color:var(--text)}.toggleline{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}.chip{padding:8px 11px;border-radius:999px;background:var(--surface2);border:1px solid var(--line);color:var(--muted);font-size:12px;font-weight:700}.chip.on{background:var(--pink2);color:var(--pink);border-color:#e83b9160}
.sectionTitle{display:flex;justify-content:space-between;align-items:end;margin:16px 3px 9px}.sectionTitle h2{font-size:15px;margin:0}.sectionTitle span{font-size:11px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px}.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;position:relative;box-shadow:0 5px 20px #8b527018}.card.have{border-color:#e83b9160;box-shadow:0 7px 24px #e83b9120}.visual{aspect-ratio:0.72;background:radial-gradient(circle at 50% 20%,#fff 0,#fbe8f5 45%,#ead0e7 100%);display:flex;align-items:center;justify-content:center;padding:12px;position:relative}.visual::before{content:"✦";position:absolute;top:9px;left:12px;color:#fff;font-size:28px;text-shadow:0 1px 8px #e83b91}.visual::after{content:"✦  ✧  ✦";position:absolute;bottom:8px;color:#fff;font-size:16px;letter-spacing:7px}.cardimg{width:100%;height:100%;object-fit:contain;display:block;border-radius:10px;position:relative;z-index:1;filter:drop-shadow(0 5px 10px #6d476020);transition:filter .2s,opacity .2s}.card:not(.have) .cardimg{opacity:.34;filter:grayscale(.35) saturate(.55) drop-shadow(0 3px 7px #6d476012)}.card.have .cardimg{opacity:1;filter:drop-shadow(0 5px 10px #6d476020)}.imgFallback{width:78%;height:72%;border-radius:20px;border:2px dashed #d6aec9;background:linear-gradient(135deg,#fff,#f7e4f1);display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;color:#9b6b8c;font-weight:900;font-size:12px;position:relative;z-index:1}.sil{width:78%;height:72%;border-radius:40% 40% 30% 30%;border:3px solid #fff;background:linear-gradient(135deg,#ffd5ea,#fff,#e7d5ff);box-shadow:0 4px 22px #d76ba850;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;color:#9b6b8c;font-weight:900;font-size:13px}.badge{position:absolute;top:10px;right:10px;border-radius:9px;padding:4px 7px;background:#d64c93;color:white;font-size:10px;font-weight:900}.pbadge{background:#6d64c7}.body{padding:11px}.no{font-size:11px;color:var(--muted);font-weight:800}.name{font-weight:800;font-size:13px;line-height:1.35;margin:3px 0 7px}.meta{font-size:10px;color:var(--muted)}.actions{display:flex;flex-direction:column;gap:7px;margin-top:10px}.counter{display:flex;align-items:center;justify-content:space-between;width:100%;box-sizing:border-box;border:1px solid #f2d9e9;border-radius:999px;padding:4px;background:#fff7fb;box-shadow:inset 0 0 0 5px #fffdfd}.counter button{width:42px;height:42px;flex:0 0 42px;border-radius:50%;border:0;background:#fff;color:#e83b91;font-weight:900;font-size:27px;line-height:1}.counter b{font-size:18px;min-width:52px;text-align:center;color:#3f3040}.want{align-self:flex-end;padding:8px 15px;border-radius:999px;border:1px solid var(--line);background:var(--surface2);color:var(--muted);font-size:11px;font-weight:800}.want.on{background:#e9f7f4;color:#3c9b8b}.parallelNote{font-size:10px;color:var(--muted);margin-top:7px}
.coords{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}.coord{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:14px}.coordImgs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:12px 0}.coordImg{position:relative;aspect-ratio:0.72;overflow:hidden;border-radius:10px;background:var(--surface2);border:1px solid var(--line)}.coordImg img{width:100%;height:100%;object-fit:cover;display:block}.coordImg small{position:absolute;left:3px;right:3px;bottom:3px;background:rgba(0,0,0,.62);color:#fff;border-radius:5px;padding:2px 3px;font-size:8px;text-align:center}.coordImg img{transition:opacity .2s,filter .2s}.coordImg.unowned img{opacity:.34;filter:grayscale(.35) saturate(.55)}.coordImg.owned img{opacity:1;filter:none}.coordHead{display:flex;justify-content:space-between;gap:8px}.coord h3{margin:0;font-size:16px}.coord small{color:var(--muted)}
