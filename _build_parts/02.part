 .progress{height:7px;border-radius:99px;background:var(--surface2);overflow:hidden;margin:11px 0}.progress i{display:block;height:100%;background:linear-gradient(90deg,#e83b91,#8e70d9);width:0}.parts{display:grid;gap:6px}.part{display:flex;justify-content:space-between;align-items:center;padding:8px 9px;border:1px solid var(--line);border-radius:11px;font-size:11px}.part.ok{background:#fff0f7}.part button{background:none;color:var(--pink);font-weight:900}.empty{padding:35px;text-align:center;color:var(--muted)}.footer{position:fixed;bottom:0;left:0;right:0;padding:9px 12px;background:color-mix(in srgb,var(--surface) 94%,transparent);border-top:1px solid var(--line);text-align:center;font-size:10px;color:var(--muted);z-index:4}
@media(max-width:650px){.filters{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:repeat(2,1fr);gap:8px}.card{border-radius:15px}.visual{aspect-ratio:.68}main{padding-left:10px;padding-right:10px}}
</style></head><body><div id="app"><header><div class="brand"><div class="logo">♡</div><div><h1>アイカツ！アンコール カード帳 ✦</h1><div class="sub">公式カードリスト対応｜1弾・プロモ・パラレル</div></div></div><div class="stats"><div class="stat"><b id="collected">0</b><small>所持カード</small></div><div class="stat"><b id="total">0</b><small>チェック対象</small></div><div class="stat"><b id="wanted">0</b><small>ほしい</small></div></div></header><main>
<div class="tabs"><button class="tab active" data-tab="cards">カード</button><button class="tab" data-tab="coords">コーデ</button></div>
<section id="cardsView"><div class="toolbar"><input id="search" class="search" placeholder="カード番号・カード名・ブランドで検索"><div class="filters"><select id="rarity"><option value="">レアリティ：すべて</option><option>ER</option><option>PR</option><option>R</option><option>N</option></select><select id="type"><option value="">タイプ：すべて</option><option>キュート</option><option>クール</option><option>セクシー</option><option>ポップ</option></select><select id="category"><option value="">カテゴリ：すべて</option><option>トップス</option><option>ボトムス</option><option>シューズ</option><option>トップス＆ボトムス</option><option>フルコーデ</option><option>アクセサリー</option></select><select id="brand"><option value="">ブランド：すべて</option><option>Angely Sugar</option><option>FUTURING GIRL</option><option>SPICY AGEHA</option><option>Dreamy Crown</option><option>Maple Ribbon</option><option>ノーブランド</option></select></div><div class="toggleline"><button class="chip on" id="showNormal">通常＋プロモ</button><button class="chip" id="showParallel">パラレルだけ</button><button class="chip" id="showAll">すべて</button><button class="chip" id="showUnowned">未所持だけ</button><button class="chip" id="showWanted">ほしいだけ</button></div></div><div class="sectionTitle"><h2 id="resultTitle">カード一覧</h2><span id="resultCount"></span></div><div id="grid" class="grid"></div></section>
<section id="coordsView" hidden><div class="sectionTitle"><h2>コーデの揃い具合</h2><span>登録済みカードから判定した47種類</span></div><div id="coords" class="coords"></div></section>
</main><div class="footer">所持数・ほしい設定はこの端末のブラウザに自動保存。公式カードリストの現行掲載分を収録（通常85＋プロモ28＋パラレル26）。</div></div>
<script>const DATA={"cards":[